      VALUE "FileDescription",  "Gestor de Tokens - agente de consumo de Claude Code"
      VALUE "FileVersion",      "2.3.0"
      VALUE "InternalName",     "GestorTokens"
      VALUE "LegalCopyright",   "DLW Latam - Uso interno"
      VALUE "OriginalFilename", "GestorTokens.exe"
      VALUE "ProductName",      "Gestor de Tokens"
      VALUE "ProductVersion",   "2.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
